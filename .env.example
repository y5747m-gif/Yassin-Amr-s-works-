# ============================================================================
# Pixelio — Environment Variables (.env.example)
# Copy to .env for local development or add to Vercel Project Settings.
# NEVER expose SUPABASE_SERVICE_ROLE_KEY or SESSION_SECRET in frontend files.
# ============================================================================

# --- Supabase Persistent Storage (Backend Only) ---
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Owner Authentication ---
OWNER_USER=owner
OWNER_PASS=TWE@2026
SESSION_SECRET=replace-with-a-long-random-secret-string

# --- Server Port (Local Development) ---
PORT=3000
